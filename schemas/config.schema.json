{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAFS Configuration",
  "description": "SSH hosts and remote folders used by SAFS.",
  "type": "object",
  "required": [
    "hosts"
  ],
  "properties": {
    "encrypt_passwords": {
      "type": "boolean",
      "default": true,
      "description": "使用 SAFS 主口令加密配置中的密码。"
    },
    "hosts": {
      "type": "array",
      "description": "可连接的 SSH 主机。",
      "items": {
        "$ref": "#/definitions/host"
      },
      "defaultSnippets": [
        {
          "label": "添加 SSH 主机",
          "body": [
            {
              "name": "${1:开发机}",
              "ip": "${2:10.0.0.2}",
              "accounts": [
                {
                  "user": "${3:alice}",
                  "port": 22,
                  "private_key_path": "${4:~/.ssh/id_ed25519}"
                }
              ]
            }
          ]
        }
      ]
    },
    "mounts": {
      "type": "array",
      "deprecated": true,
      "description": "已废弃：SAFS 会根据 hosts 自动生成挂载，无需手动维护。",
      "items": {
        "$ref": "#/definitions/mount"
      }
    },
    "host_aliases": {
      "type": "object",
      "description": "远程目录视图中按 IP 分组节点的显示名称。",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "host": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "name",
            "ip",
            "accounts"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "SAFS 主机节点显示名称。"
            },
            "ip": {
              "type": "string",
              "minLength": 1,
              "description": "服务器 IP 地址或域名。"
            },
            "accounts": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/account"
              },
              "description": "此主机下的 SSH 登录账号；历史目录保存在 VS Code 全局状态中。"
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/definitions/legacyHost"
        }
      ]
    },
    "mount": {
      "type": "object",
      "required": [
        "name",
        "host",
        "remote_path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "挂载名；通常由 hosts 派生（保存时会省略 mounts 数组）。"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "对应 hosts 中的 name。"
        },
        "remote_path": {
          "type": "string",
          "minLength": 1,
          "default": ".",
          "description": "SFTP 远程目录；`.` 表示 SSH 登录目录。"
        },
        "local_path": {
          "type": "string",
          "deprecated": true,
          "description": "旧版 SSHFS 本地路径；SFTP 版本会忽略此字段。"
        },
        "local_paths": {
          "type": "object",
          "deprecated": true,
          "description": "旧版分平台 SSHFS 路径；SFTP 版本会忽略此字段。"
        },
        "remote_terminal": {
          "type": "string",
          "enum": [
            "open"
          ],
          "enumDescriptions": [
            "打开目录后连接终端。"
          ],
          "default": "open",
          "description": "远程终端的打开方式。"
        }
      },
      "additionalProperties": false
    },
    "legacyHost": {
      "type": "object",
      "required": [
        "ip"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "主机内部名称（也是挂载名与 safs:// 的 authority）；留空会用 IP。SAFS 启动时按「别名(账号)」自动生成/迁移，手填的名字会被改写。"
        },
        "ip": {
          "type": "string",
          "minLength": 1,
          "description": "服务器 IP 地址或域名。"
        },
        "user": {
          "type": "string",
          "description": "SSH 登录用户名；可先留空，稍后从 SAFS 分层视图补充。"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22,
          "description": "SSH 端口。"
        },
        "vpn": {
          "type": "boolean",
          "default": false,
          "description": "是否通过 VPN 可见的网络连接。"
        },
        "private_key_path": {
          "type": "string",
          "description": "SSH 私钥路径，例如 ~/.ssh/id_ed25519。"
        },
        "password": {
          "type": "string",
          "description": "SSH 密码；使用私钥时无需填写，避免提交到版本库。"
        },
        "auth": {
          "type": "string",
          "enum": [
            "auto",
            "password",
            "publickey",
            "agent",
            "keyboard-interactive"
          ],
          "description": "SSH 认证方式；默认自动选择。手动配置仅在显式选择 agent 或配置 agent_socket 时使用 SSH agent。"
        },
        "agent_socket": {
          "type": "string",
          "description": "显式 SSH agent Unix socket 或 Windows named pipe。"
        },
        "proxy_command": {
          "type": "string",
          "description": "代理可执行文件及参数；shell 运算符须封装在脚本中。"
        },
        "jump_host": {
          "type": "string",
          "description": "SAFS 中配置的跳板机连接名（可用 user@host:port，多跳以逗号分隔）。"
        },
        "socks_proxy": {
          "type": "string",
          "description": "SOCKS 代理 host:port。"
        },
        "http_proxy": {
          "type": "string",
          "description": "HTTP CONNECT 代理 host:port。"
        }
      },
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "旧版账号连接标识；新版根据主机名和 user 自动生成，保存时移除此字段。",
          "deprecated": true
        },
        "user": {
          "type": "string",
          "description": "SSH 登录用户名；可先留空，稍后从 SAFS 分层视图补充。"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22,
          "description": "SSH 端口。"
        },
        "vpn": {
          "type": "boolean",
          "default": false,
          "description": "是否通过 VPN 可见的网络连接。"
        },
        "private_key_path": {
          "type": "string",
          "description": "SSH 私钥路径，例如 ~/.ssh/id_ed25519。"
        },
        "password": {
          "type": "string",
          "description": "SSH 密码；使用私钥时无需填写，避免提交到版本库。"
        },
        "connections": {
          "type": "array",
          "description": "旧挂载迁移保留的连接和远程根目录，通常无需手动填写。",
          "items": {
            "type": "object",
            "required": [
              "name",
              "remote_path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "remote_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "auth": {
          "type": "string",
          "enum": [
            "auto",
            "password",
            "publickey",
            "agent",
            "keyboard-interactive"
          ],
          "description": "SSH 认证方式；默认自动选择。手动配置仅在显式选择 agent 或配置 agent_socket 时使用 SSH agent。"
        },
        "agent_socket": {
          "type": "string",
          "description": "显式 SSH agent Unix socket 或 Windows named pipe。"
        },
        "proxy_command": {
          "type": "string",
          "description": "代理可执行文件及参数；shell 运算符须封装在脚本中。"
        },
        "jump_host": {
          "type": "string",
          "description": "SAFS 中配置的跳板机连接名（可用 user@host:port，多跳以逗号分隔）。"
        },
        "socks_proxy": {
          "type": "string",
          "description": "SOCKS 代理 host:port。"
        },
        "http_proxy": {
          "type": "string",
          "description": "HTTP CONNECT 代理 host:port。"
        }
      },
      "additionalProperties": false
    }
  }
}
